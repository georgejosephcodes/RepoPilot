# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=repopilot
POSTGRES_DB=repopilot
POSTGRES_PORT=5433
DATABASE_URL=postgres://repopilot:repopilot@localhost:5433/repopilot

API_ADDR=:8080

# Embedding provider (step 5). OpenRouter by default; any OpenAI-compatible embeddings API works.
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_API_KEY=
EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
EMBED_DIM=2048
# input_type values: OpenRouter uses search_query / search_document; NVIDIA NIM uses query / passage.
EMBED_QUERY_TYPE=search_query
EMBED_DOCUMENT_TYPE=search_document
# Optional: NVIDIA NIM (build.nvidia.com) free API key, starts with nvapi-. Used only by worker/scripts/probe_nim.py for now.
NVIDIA_API_KEY=
# Answer model (step 7): Gemini flash-lite, verified by a real probe. LLM_API_KEY falls back to GEMINI_API_KEY.
LLM_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1024
LLM_THINKING_LEVEL=minimal
LLM_TIMEOUT_SEC=45

# Question answering (step 7)
RETRIEVAL_TOP_K=8
CONTEXT_BUDGET_CHARS=24000
MAX_QUESTION_CHARS=1000
# Each question makes 2 Gemini requests (rerank and answer); Gemini allows 15 per minute.
QUERY_RATE_LIMIT_PER_MIN=7

# Retrieval pipeline (Phase 2 step 7). Defaults are the values chosen on the dev split.
# vector = Phase 1 search (the rollback), hybrid = vector + BM25 keyword search fused with RRF,
# hybrid_rerank = hybrid, then the answer model reorders the top RERANK_DEPTH (needs migrations/004).
RETRIEVAL_MODE=hybrid_rerank
HYBRID_RRF_K=60
HYBRID_KEYWORD_WEIGHT=0.75
HYBRID_TEST_PENALTY=0.5
HYBRID_POOL=20
RERANK_DEPTH=20
# A rerank call slower than this falls back to the hybrid order.
RERANK_TIMEOUT_SEC=10

GIN_MODE=release
RATE_LIMIT_PER_MIN=30

# Worker limits (step 3). WORK_DIR defaults to <system temp>/repopilot
CLONE_TIMEOUT_SEC=120
MAX_REPO_MB=200
MAX_FILES=5000
MAX_FILE_KB=200
# WORK_DIR=/tmp/repopilot

# Chunking (step 4)
CHUNK_MAX_LINES=120
CHUNK_OVERLAP_LINES=10
CHUNK_MIN_GAP_LINES=3

# Embedding behaviour (step 5). Free OpenRouter models: 20 requests/min, 50 requests/day without purchased credit.
EMBED_BATCH_SIZE=64
EMBED_BATCH_TOKENS=40000
EMBED_MAX_CHARS=8000
EMBED_RPM=20
EMBED_RESERVE_REQUESTS=10
